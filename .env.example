POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=MovieReservationDb
# At least 32 bytes, e.g. generated with: openssl rand -base64 64
JWT_SECRET_KEY=
# Password of the initial admin account (admin@cinema.com); only used when that account does not exist yet.
ADMIN_PASSWORD=
SMTP_USERNAME=
SMTP_PASSWORD=
# Development also shows exception messages in 500 responses; keep Production outside local debugging.
ASPNETCORE_ENVIRONMENT=Production
